{
  "manifest_version": 3,
  "name": "Grove — Tab Tree & Sessions",
  "version": "1.0.0",
  "description": "Keep as many tabs as you like. A durable, searchable sidebar outline of your live and saved windows — close tabs to reclaim memory and lose nothing.",
  "permissions": ["tabs", "sessions", "storage", "unlimitedStorage", "alarms", "downloads"],
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "action": {
    "default_title": "Open Grove",
    "default_area": "menupanel",
    "default_icon": {
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    }
  },
  "background": {
    "scripts": ["background/background.js"]
  },
  "sidebar_action": {
    "default_title": "Grove",
    "default_panel": "sidebar/sidebar.html",
    "default_icon": "icons/icon.svg",
    "open_at_install": true
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "windows": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      }
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "grove@sarkologist.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
